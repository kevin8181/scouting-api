{
	"name": "scouting-api-workspace",
	"version": "0.1.0",
	"private": true,
	"description": "Unofficial, community-maintained descriptions of Scouting America APIs, starting with api.scouting.org.",
	"keywords": [
		"scouting",
		"api",
		"scouting america",
		"openapi"
	],
	"homepage": "https://github.com/kevin8181/scouting-api#readme",
	"bugs": {
		"url": "https://github.com/kevin8181/scouting-api/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kevin8181/scouting-api.git"
	},
	"license": "MIT",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "pnpm --filter @scouting-api/spec dev",
		"lint": "pnpm -r lint",
		"build": "pnpm -r build",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "pnpm -r typecheck",
		"knip": "knip --treat-config-hints-as-errors",
		"check": "pnpm format && pnpm lint && pnpm typecheck && pnpm knip",
		"test": "pnpm -r test"
	},
	"packageManager": "pnpm@10.24.0",
	"devDependencies": {
		"knip": "^6.39.0",
		"prettier": "^3.9.9"
	}
}
