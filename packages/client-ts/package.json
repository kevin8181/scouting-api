{
	"name": "@scouting-commons/scouting-api",
	"version": "0.1.1",
	"type": "module",
	"description": "TypeScript client for Scouting America APIs, generated from the specs.",
	"keywords": [
		"scouting",
		"scouting america",
		"api",
		"openapi"
	],
	"homepage": "https://github.com/scouting-commons/scouting-api/tree/main/packages/client-ts#readme",
	"bugs": {
		"url": "https://github.com/scouting-commons/scouting-api/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/scouting-commons/scouting-api.git",
		"directory": "packages/client-ts"
	},
	"license": "MIT",
	"exports": {
		"./api.scouting.org": "./dist/api.scouting.org.js",
		"./scoutconnect-api.scouting.org": "./dist/scoutconnect-api.scouting.org.js",
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"generate": "openapi-ts",
		"build": "openapi-ts && tsdown",
		"typecheck": "openapi-ts && tsc",
		"prepack": "pnpm build"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@hey-api/openapi-ts": "0.99.0",
		"@scouting-commons/scouting-api-spec": "workspace:*",
		"publint": "^0.3.25",
		"tsdown": "^0.23.0",
		"typescript": "^6.0.3"
	}
}
